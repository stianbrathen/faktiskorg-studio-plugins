  "shared/labrador-status.js": "// Faktisk Studio — Labrador-tilkoblingsstatus i toppbaren (delt fil)\n//\n// Selvforsynt: injiserer egen CSS og en statusbrikke i .topbar__actions.\n// Viser tydelig om Studio er koblet til Labrador (grønn prikk) eller ikke\n// (grå prikk + «Koble til»). Klikk kobler til / sjekker på nytt.\n// Inkluderes med <script src=\"shared/labrador-status.js\"> etter topbaren\n// (i src/ på malsiden). Kanonisk kilde: plugins/_shared/.\n\n(function () {\n  'use strict';\n  if (!window.faktisk || !window.faktisk.labradorStatus) return;\n  const bar = document.querySelector('.topbar__actions');\n  if (!bar || document.getElementById('labStatusChip')) return;\n\n  const css = document.createElement('style');\n  css.textContent = `\n    .lab-chip {\n      display: flex; align-items: center; gap: 7px;\n      background: rgba(255,255,255,0.12);\n      border: 0; border-radius: 18px;\n      padding: 6px 14px; margin-right: 6px;\n      font-family: var(--font-bold, inherit); font-weight: bold;\n      font-size: 12px; color: #fff; cursor: pointer;\n      white-space: nowrap;\n    }\n    .lab-chip:hover { background: rgba(255,255,255,0.24); }\n    .lab-chip__dot {\n      width: 9px; height: 9px; border-radius: 50%;\n      background: #999; flex-shrink: 0;\n      transition: background 0.2s;\n    }\n    .lab-chip.on .lab-chip__dot { background: #2ecc5e; box-shadow: 0 0 6px rgba(46,204,94,0.7); }\n    .lab-chip.checking .lab-chip__dot { background: #f5c542; }\n  `;\n  document.head.appendChild(css);\n\n  const chip = document.createElement('button');\n  chip.id = 'labStatusChip';\n  chip.className = 'lab-chip checking';\n  chip.type = 'button';\n  chip.innerHTML = '<span class=\"lab-chip__dot\"></span><span class=\"lab-chip__label\">Labrador…</span>';\n  bar.insertBefore(chip, bar.firstChild);\n  const label = chip.querySelector('.lab-chip__label');\n\n  let connected = false;\n  let busy = false;\n\n  function render(state) {\n    chip.classList.remove('on', 'checking');\n    if (state === 'on') {\n      chip.classList.add('on');\n      label.textContent = 'Labrador tilkoblet';\n      chip.title = 'Koblet til Labrador — «Mine filer» og opplasting virker i alle verktøy. Klikk for å sjekke på nytt.';\n    } else if (state === 'checking') {\n      chip.classList.add('checking');\n      label.textContent = 'Labrador…';\n      chip.title = 'Sjekker Labrador-tilkobling…';\n    } else {\n      label.textContent = 'Koble til Labrador';\n      chip.title = 'Ikke innlogget — klikk for å logge inn. Gjelder alle verktøyene.';\n    }\n  }\n\n  async function check() {\n    if (busy) return;\n    render('checking');\n    try {\n      const st = await window.faktisk.labradorStatus();\n      connected = !!st.loggedIn;\n    } catch (e) {\n      connected = false;\n    }\n    render(connected ? 'on' : 'off');\n  }\n\n  chip.addEventListener('click', async () => {\n    if (busy) return;\n    busy = true;\n    try {\n      if (connected) {\n        busy = false;\n        await check();\n        return;\n      }\n      render('checking');\n      label.textContent = 'Logg inn i vinduet…';\n      const st = await window.faktisk.labradorConnect();\n      connected = !!st.loggedIn;\n      render(connected ? 'on' : 'off');\n    } catch (e) {\n      render('off');\n    } finally {\n      busy = false;\n    }\n  });\n\n  window.addEventListener('focus', check);\n  check();\n})();\n",
  "shared/logo.svg": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg id=\"Layer_2\" data-name=\"Layer 2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 557.01 80.99\">\n  <g id=\"Layer_1-2\" data-name=\"Layer 1\">\n    <g>\n      <g>\n        <path d=\"M86.31,11.13h9.71v34.3l14.16-17.31h11.57l-16.02,18.69,17.72,23.05h-12.13l-15.29-20.71v20.71h-9.71V11.13Z\"/>\n        <path d=\"M132.26,28.12v-10.35h9.71v10.35h8.25v7.44h-8.25v19.66c0,5.1,1.13,7.52,5.02,7.52.81,0,1.78,0,3.32-.32v7.44c-2.18.57-4.04.73-6.23.73-8.25,0-11.81-3.96-11.81-13.43v-21.6h-6.71v-7.44h6.71Z\"/>\n        <path d=\"M158.88,11.13h9.71v9.79h-9.71v-9.79ZM158.88,28.12h9.71v41.74h-9.71V28.12Z\"/>\n        <path d=\"M185.41,56.51c0,5.02,3.07,7.52,8.9,7.52,4.61,0,7.6-1.94,7.6-5.18,0-4.13-4.69-5.26-10.03-6.55-7.12-1.7-15.53-3.56-15.53-12.7,0-7.6,6.8-12.62,17.39-12.62s17.31,4.77,17.31,13.91h-9.63c-.16-4.93-2.75-6.96-8.01-6.96-4.29,0-7.04,1.86-7.04,4.85,0,4.53,6.15,5.5,12.38,7.12,6.55,1.7,13.19,4.13,13.19,12.13s-6.88,12.94-17.72,12.94c-11.81,0-18.61-5.02-18.77-14.48h9.95Z\"/>\n        <path d=\"M218.25,11.13h9.71v34.3l14.16-17.31h11.57l-16.02,18.69,17.72,23.05h-12.13l-15.29-20.71v20.71h-9.71V11.13Z\"/>\n        <path d=\"M260.32,58.45h11v11.41h-11v-11.41Z\"/>\n        <path d=\"M0,37.58v32.28h10.27v-23.78h25.48v-8.49H0Z\"/>\n        <path d=\"M0,11.13v19.82h10.27v-11.33h27.42v-8.49H0Z\"/>\n        <path d=\"M69.25,64.44c-3.48,4.21-7.44,6.23-13.99,6.23-9.22,0-14.48-4.61-14.48-12.38,0-13.35,16.74-13.51,27.34-14.72v-1.78c0-5.1-2.51-7.93-7.6-7.93s-8.17,2.59-8.25,7.04h-9.95c.32-8.74,7.36-13.91,18.2-13.91,13.27,0,17.07,6.96,17.07,18.12v11.65c0,4.61.16,8.66.89,13.11h-8.82c-.24-1.62-.32-3.32-.4-5.42ZM68.11,50.2c-7.28.97-17.31.81-17.31,7.93,0,3.56,2.51,5.82,6.96,5.82,5.99,0,10.35-2.91,10.35-11.97v-1.78Z\"/>\n      </g>\n      <g>\n        <path d=\"M515.65,31.15c-8.55,0-12.99,7.16-12.99,16.18s4.43,16.1,12.99,16.1,12.99-7.08,12.99-16.1-4.43-16.18-12.99-16.18Z\"/>\n        <path d=\"M450.71,31.46c-7.7,0-11.59,6.84-11.59,16.02s3.89,15.94,11.59,15.94c8.94,0,12.83-6.77,12.83-15.94s-4.43-16.02-12.83-16.02Z\"/>\n        <path d=\"M544.01,0h-244.06c-7.18,0-13,5.82-13,13v54.99c0,7.18,5.82,13,13,13h244.06c7.18,0,13-5.82,13-13V13c0-7.18-5.82-13-13-13ZM332.8,69.33c-16.18,0-24.19-8.87-24.81-19.91h7.85c.93,8.71,6.69,13.53,17.19,13.53,7.7,0,13.3-3.42,13.3-10.42,0-7.54-6.69-9.33-16.8-11.59-10.34-2.18-19.13-5.13-19.13-16.25,0-9.72,8.17-15.48,20.07-15.48,14.23,0,20.61,7.16,22.01,17.03h-7.7c-1.01-7-6.07-10.81-14.23-10.81-7.62,0-12.6,3.11-12.6,8.87,0,6.3,6.3,8.09,15.01,9.88,11.2,2.25,21.39,5.13,21.39,18.04,0,10.97-9.02,17.11-21.54,17.11ZM382.58,32h-8.63v26.37c0,3.03,1.63,3.89,4.28,3.89,1.24,0,2.88-.31,3.66-.54h.23v6.07c-1.94.47-3.97.7-5.83.7-5.6-.08-9.49-2.33-9.49-8.48v-28h-6.53v-5.6h6.53v-13.14h7.16v13.14h8.63v5.6ZM423.95,68.17h-7.16v-5.83h-.16c-2.96,4.12-6.61,6.77-12.6,6.77-8.63,0-14.16-5.21-14.16-13.92v-28.78h7.23v28.39c0,5.29,3.34,8.4,9.1,8.4,6.38,0,10.5-4.9,10.5-11.36v-25.43h7.23v41.76ZM470.38,68.17h-7.16v-5.99h-.16c-2.64,4.51-7.08,7.23-12.91,7.23-11.28,0-18.43-8.55-18.43-22.01s7.93-22.01,18.28-22.01c5.91,0,10.58,2.96,13.22,7.39h.16c-.16-1.87-.23-4.9-.23-7.7v-14.78h7.23v57.86ZM487.57,68.17h-7.23V26.4h7.23v41.76ZM487.73,18.7h-7.54v-8.4h7.54v8.4ZM515.72,69.33c-12.6,0-20.46-9.8-20.46-22.01s7.86-21.93,20.46-21.93,20.3,9.8,20.3,21.93-7.7,22.01-20.3,22.01Z\"/>\n      </g>\n    </g>\n  </g>\n</svg>",
  "shared/new-project.js": "// Delt hjelper: kobler #newProjectBtn til stateClear + reload.\n// Plugin må ha en knapp med id=\"newProjectBtn\" i topbaren OG sette\n// window.PLUGIN_ID til pluginens id (samme som mappe-navnet i plugins/).\n(function () {\n  document.addEventListener('DOMContentLoaded', function () {\n    var btn = document.getElementById('newProjectBtn');\n    if (!btn) return;\n    btn.addEventListener('click', async function () {\n      try {\n        var ok = await window.faktiskDialog.confirm(\n          'Slett gjeldende arbeid og start på nytt?\\n\\nLagrede prosjekter beholdes.',\n          true\n        );\n        if (!ok) return;\n        var id = window.PLUGIN_ID || (document.querySelector('meta[name=\"plugin-id\"]') || {}).content;\n        if (id && window.faktisk && window.faktisk.stateClear) {\n          await window.faktisk.stateClear(id);\n        }\n        location.reload();\n      } catch (e) {\n        console.error(e);\n      }\n    });\n  });\n})();\n",
  "shared/recent-files-panel.css": "/* Delt \"Nylige filer\"-panel — styling delt av alle plugins */\n\n.recent-files-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n.rfp-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n.rfp-label {\n  font-family: var(--font-bold);\n  font-size: 12px;\n  font-weight: bold;\n  color: #fff;\n}\n.rfp-refresh {\n  background: rgba(255,255,255,0.14);\n  color: #fff;\n  border: 0;\n  border-radius: 4px;\n  width: 22px; height: 22px;\n  font-size: 14px;\n  line-height: 1;\n  cursor: pointer;\n  padding: 0;\n}\n.rfp-refresh:hover { background: rgba(255,255,255,0.25); }\n\n.rfp-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 4px;\n  min-height: 40px;\n}\n.rfp-loading, .rfp-empty {\n  grid-column: 1 / -1;\n  font-size: 11px;\n  color: rgba(255,255,255,0.7);\n  font-style: italic;\n  padding: 8px 4px;\n  line-height: 1.4;\n}\n.rfp-tile {\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 2px;\n  background: rgba(255,255,255,0.06);\n  border: 0;\n  border-radius: 4px;\n  overflow: hidden;\n  cursor: pointer;\n  padding: 0;\n  transition: background 0.12s, transform 0.12s;\n}\n.rfp-tile:hover { background: rgba(255,255,255,0.15); transform: translateY(-1px); }\n.rfp-tile__img, .rfp-tile__vid, .rfp-tile__doc {\n  width: 100%;\n  aspect-ratio: 4 / 3;\n  object-fit: cover;\n  display: block;\n  background: #222;\n  color: rgba(255,255,255,0.7);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-bold);\n  font-weight: bold;\n  font-size: 14px;\n}\n.rfp-tile__vid { background: linear-gradient(135deg, #1a3a5c 0%, #0f2140 100%); font-size: 22px; }\n.rfp-tile__doc { background: #2a2a2a; font-size: 11px; letter-spacing: 0.08em; }\n.rfp-tile__name {\n  font-size: 9px;\n  color: rgba(255,255,255,0.85);\n  font-family: var(--font-bold);\n  font-weight: bold;\n  padding: 2px 4px 4px;\n  text-align: center;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n",
  "shared/recent-files-panel.js": "// Delt \"Nylige filer\"-panel som alle plugins kan bruke.\n//\n// Bruk:\n//   1) Legg til container-element i sidebar: <div id=\"recentFilesPanel\" data-type=\"image\"></div>\n//      (data-type kan være \"image\", \"video\" eller utelates for alle typer)\n//   2) Inkluder dette scriptet.\n//   3) Lytt på \"faktisk-recent-file-picked\"-eventet på containeren for å motta valgte URL:\n//        el.addEventListener('faktisk-recent-file-picked', e => { pluginState.url = e.detail.url; ... });\n//   4) Registrer URL i historikken når du laster den:\n//        window.faktisk.recentFileAdd({ url, type: 'image', alt: 'name', pluginId: PLUGIN_ID });\n//\n// Panelet oppdaterer seg automatisk ved åpning og har manuell refresh-knapp.\n(function () {\n  document.addEventListener('DOMContentLoaded', function () {\n    var panels = document.querySelectorAll('.recent-files-panel, [data-recent-files-panel]');\n    if (panels.length === 0) {\n      var singleton = document.getElementById('recentFilesPanel');\n      if (singleton) panels = [singleton];\n    }\n    panels.forEach(setup);\n  });\n\n  function setup(container) {\n    container.classList.add('recent-files-panel');\n    var filter = container.dataset.type || '';\n    render(container, filter);\n  }\n\n  async function render(container, filter) {\n    container.innerHTML = `\n      <div class=\"rfp-head\">\n        <span class=\"rfp-label\">Nylige filer</span>\n        <button type=\"button\" class=\"rfp-refresh\" title=\"Oppdater lista\">↻</button>\n      </div>\n      <div class=\"rfp-grid\" role=\"list\">\n        <div class=\"rfp-loading\">Laster…</div>\n      </div>`;\n    container.querySelector('.rfp-refresh').onclick = () => render(container, filter);\n\n    try {\n      var opts = { limit: 18 };\n      if (filter) opts.type = filter;\n      var res = await window.faktisk.recentFileList(opts);\n      var grid = container.querySelector('.rfp-grid');\n      if (!res.ok || !res.files || res.files.length === 0) {\n        grid.innerHTML = '<div class=\"rfp-empty\">Ingen filer enda. Åpne Labrador og last opp — filen dukker opp her når du bruker den i en plugin.</div>';\n        return;\n      }\n      grid.innerHTML = res.files.map(function (f) {\n        var thumb = '';\n        if (f.type === 'image') {\n          thumb = '<img class=\"rfp-tile__img\" src=\"' + esc(f.url) + '\" alt=\"\" loading=\"lazy\">';\n        } else if (f.type === 'video') {\n          thumb = '<div class=\"rfp-tile__vid\">▶</div>';\n        } else {\n          thumb = '<div class=\"rfp-tile__doc\">FIL</div>';\n        }\n        var short = shortName(f.url);\n        return (\n          '<button class=\"rfp-tile\" role=\"listitem\" data-url=\"' + esc(f.url) + '\" data-type=\"' + esc(f.type) + '\" data-alt=\"' + esc(f.alt || '') + '\" title=\"' + esc(f.url) + '\">' +\n            thumb +\n            '<span class=\"rfp-tile__name\">' + esc(short) + '</span>' +\n          '</button>'\n        );\n      }).join('');\n      grid.querySelectorAll('.rfp-tile').forEach(function (btn) {\n        btn.addEventListener('click', function () {\n          var url = btn.dataset.url;\n          var type = btn.dataset.type;\n          var alt = btn.dataset.alt || '';\n          container.dispatchEvent(new CustomEvent('faktisk-recent-file-picked', {\n            detail: { url: url, type: type, alt: alt },\n            bubbles: true,\n          }));\n        });\n      });\n    } catch (e) {\n      console.error(e);\n      container.querySelector('.rfp-grid').innerHTML = '<div class=\"rfp-empty\">Kunne ikke laste lista.</div>';\n    }\n  }\n\n  function esc(s) {\n    return String(s == null ? '' : s).replace(/[<>&\"']/g, function (c) {\n      return ({'<':'&lt;','>':'&gt;','&':'&amp;','\"':'&quot;',\"'\":'&#39;'}[c]);\n    });\n  }\n  function shortName(url) {\n    try {\n      var u = new URL(url);\n      var last = u.pathname.split('/').filter(Boolean).pop() || u.host;\n      if (last.length > 22) last = last.slice(0, 10) + '…' + last.slice(-9);\n      return last;\n    } catch (e) { return url; }\n  }\n})();\n",
  "shared/style.css": "/* ============================================\n   FAKTISK STUDIO — designsystem\n   Henter farger og radii fra Figma-skissen\n   ============================================ */\n\n:root {\n  --faktisk-blue: #0050FC;\n  --faktisk-blue-hover: #0040D9;\n  --bg-page: #9D9D9D;\n  --bg-topbar: #707070;\n  --bg-placeholder: #7B7B7B;\n  --bg-letterbox: #878787;\n  --bg-input: #D9D9D9;\n  --text-on-blue: #FFFFFF;\n  --text-topbar-title: #414141;\n  --text-placeholder: #8B8B8B;\n  --text-input: #313131;\n\n  --radius-container: 30px;\n  --radius-card: 15px;\n  --radius-button: 11px;\n  --radius-button-sm: 7px;\n  --radius-input: 6px;\n\n  --font-bold: \"Haas Grot Text 75 Bold\", \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n  --font-regular: \"Haas Grot Text 55 Roman\", \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n}\n\n* { box-sizing: border-box; }\n\nhtml, body {\n  margin: 0;\n  padding: 0;\n  height: 100%;\n  background: var(--bg-page);\n  font-family: var(--font-regular);\n  color: #fff;\n  user-select: none;\n  -webkit-user-select: none;\n  overflow: hidden;\n}\n\nbutton {\n  font-family: inherit;\n  border: 0;\n  cursor: pointer;\n  background: none;\n  color: inherit;\n  padding: 0;\n}\n\n/* ============================================\n   Hovedcontainer\n   ============================================ */\n.studio {\n  background: var(--bg-page);\n  border-radius: var(--radius-container);\n  padding: 41px 26px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  height: 100%;\n  overflow: hidden;\n}\n\n/* ============================================\n   Topp-bar\n   ============================================ */\n.topbar {\n  background: var(--bg-topbar);\n  border-radius: var(--radius-card);\n  padding: 22px 27px;\n  display: flex;\n  align-items: center;\n  gap: 24px;\n  flex-shrink: 0;\n}\n\n/* Diskret versjonsindikator ved siden av logo */\n.topbar__version {\n  font-family: var(--font-bold);\n  font-size: 11px;\n  font-weight: bold;\n  color: #fff;\n  opacity: 0.5;\n  letter-spacing: 0.04em;\n  white-space: nowrap;\n  margin-left: -12px;   /* trekk tett inn mot logo */\n}\n\n/* Labrador-logo i toppen — hvit via CSS-mask */\n.topbar__title {\n  flex: 1;\n  height: 28px;\n  margin: 0;\n  background: #fff;\n  -webkit-mask: url('labrador-logo.svg') no-repeat center / contain;\n  mask: url('labrador-logo.svg') no-repeat center / contain;\n}\n\n.topbar__actions {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.btn-primary {\n  background: var(--faktisk-blue);\n  color: #fff;\n  font-family: var(--font-bold);\n  font-weight: bold;\n  font-size: 15px;\n  height: 52px;\n  padding: 0 22px;\n  border-radius: var(--radius-button);\n  min-width: 129px;\n  transition: background 0.15s;\n}\n.btn-primary:hover { background: var(--faktisk-blue-hover); }\n\n.btn-icon {\n  background: var(--faktisk-blue);\n  color: #fff;\n  font-family: var(--font-bold);\n  font-size: 30px;\n  width: 52px;\n  height: 52px;\n  border-radius: var(--radius-button);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  line-height: 1;\n  transition: background 0.15s;\n}\n.btn-icon:hover { background: var(--faktisk-blue-hover); }\n\n/* Sekundærknapp i topp-bar (Mine prosjekter) */\n.btn-secondary-tb {\n  background: rgba(0,0,0,0.18);\n  color: #fff;\n  font-family: var(--font-bold);\n  font-weight: bold;\n  font-size: 15px;\n  height: 52px;\n  padding: 0 22px;\n  border-radius: var(--radius-button);\n  transition: background 0.15s;\n}\n.btn-secondary-tb:hover { background: rgba(0,0,0,0.28); }\n\n.projects-modal {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n  gap: 10px;\n  max-height: 50vh;\n  overflow: auto;\n  padding: 4px;\n}\n\n.projects-modal__empty {\n  text-align: center;\n  padding: 30px;\n  color: #666;\n  font-size: 14px;\n}\n\n/* Plugin-marked */\n.market-body {\n  max-height: 60vh;\n  overflow: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 4px;\n}\n.market-empty {\n  text-align: center;\n  padding: 40px 20px;\n  color: #666;\n  font-size: 14px;\n}\n.market-row {\n  display: flex;\n  gap: 14px;\n  align-items: center;\n  padding: 14px 16px;\n  background: #f5f5f5;\n  border-radius: 10px;\n}\n.market-row__info { flex: 1; min-width: 0; }\n.market-row__name {\n  font-family: var(--font-bold);\n  font-size: 15px;\n  font-weight: bold;\n  color: #212121;\n}\n.market-row__desc {\n  font-size: 13px;\n  color: #444;\n  margin-top: 2px;\n  line-height: 1.35;\n}\n.market-row__meta {\n  font-size: 12px;\n  color: #666;\n  margin-top: 4px;\n}\n.market-row__changelog {\n  font-size: 12px;\n  color: #555;\n  margin-top: 6px;\n  padding-top: 6px;\n  border-top: 1px solid #e0e0e0;\n  font-style: italic;\n}\n.market-row__action { flex-shrink: 0; }\n\n/* ============================================\n   Plugin-grid (Malside)\n   ============================================ */\n.malside {\n  flex: 1;\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 22px;\n  overflow: auto;\n  padding: 4px;\n}\n\n.malside__column {\n  display: flex;\n  flex-direction: column;\n  gap: 22px;\n}\n\n/* Plugin-kort — installert (blå). Fast høyde så installerte og placeholders får samme størrelse. */\n.plugin-card {\n  background: var(--faktisk-blue);\n  border-radius: var(--radius-card);\n  padding: 0 35px;\n  display: flex;\n  align-items: center;\n  cursor: pointer;\n  height: 90px;\n  transition: background 0.15s, transform 0.1s;\n}\n.plugin-card:hover { background: var(--faktisk-blue-hover); }\n.plugin-card:active { transform: scale(0.98); }\n\n.plugin-card__title {\n  font-family: var(--font-bold);\n  font-size: 22px;\n  font-weight: bold;\n  color: #fff;\n  margin: 0;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.plugin-card--placeholder {\n  background: var(--bg-placeholder);\n  display: flex;\n  justify-content: space-between;\n  cursor: default;\n}\n.plugin-card--placeholder:hover { background: var(--bg-placeholder); }\n.plugin-card--placeholder:active { transform: none; }\n\n.plugin-card--placeholder .plugin-card__title {\n  color: var(--text-placeholder);\n}\n\n.plugin-card__add {\n  background: var(--faktisk-blue);\n  color: #fff;\n  font-family: var(--font-bold);\n  font-size: 30px;\n  width: 36px;\n  height: 36px;\n  border-radius: var(--radius-button-sm);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  line-height: 1;\n  cursor: pointer;\n  flex-shrink: 0;\n  transition: background 0.15s;\n}\n.plugin-card__add:hover { background: var(--faktisk-blue-hover); }\n\n/* ============================================\n   Faktisk Studio-logo (CSS mask)\n   ============================================ */\n.faktisk-logo {\n  width: 178px;\n  height: 26px;\n  background: #fff;\n  -webkit-mask: url('logo.svg') no-repeat center / contain;\n  mask: url('logo.svg') no-repeat center / contain;\n  flex-shrink: 0;\n}\n",
  "style.css": "/* SoMe-bilde — sidebar-layout fra video-pluginene, canvas-forhåndsvisning */\n\n@font-face {\n  font-family: 'NHG';\n  src: url('fonts/NeueHaasGroteskText-65Medium.otf') format('opentype');\n  font-weight: 500;\n}\n@font-face {\n  font-family: 'NHG';\n  src: url('fonts/NeueHaasGroteskText-75Bold.otf') format('opentype');\n  font-weight: 700;\n}\n\n.plugin-page {\n  flex: 1;\n  display: grid;\n  grid-template-columns: 313px 1fr;\n  gap: 22px;\n  overflow: hidden;\n  padding: 4px;\n}\n\n.plugin-sidebar {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  padding: 0 4px;\n  overflow-y: auto;\n}\n.plugin-sidebar__title {\n  font-family: var(--font-bold);\n  font-size: 27px;\n  font-weight: bold;\n  color: #212121;\n  margin: 0;\n  line-height: 1.05;\n}\n.plugin-sidebar__desc {\n  font-family: var(--font-regular);\n  font-size: 14px;\n  color: #fff;\n  margin: 0;\n  line-height: 1.4;\n}\n.plugin-sidebar__spacer { flex: 1; }\n.plugin-sidebar__status {\n  font-size: 13px; color: #fff; min-height: 18px; opacity: 0.85;\n}\n\n.url-section { display: flex; flex-direction: column; gap: 6px; }\n.url-section__label {\n  font-family: var(--font-bold);\n  font-size: 13px; font-weight: bold; color: #fff;\n}\n.url-section__header {\n  display: flex; align-items: baseline; justify-content: space-between; gap: 8px;\n}\n.link-btn {\n  background: transparent; color: #fff;\n  font-family: var(--font-bold); font-weight: bold; font-size: 12px;\n  cursor: pointer; text-decoration: underline;\n  text-decoration-color: rgba(255,255,255,0.5);\n  text-underline-offset: 3px;\n}\n.link-btn:hover { text-decoration-color: #fff; }\n.filepick { display: inline-block; }\n\n.url-row {\n  background: var(--bg-input); height: 38px;\n  border-radius: var(--radius-input);\n  padding: 0 4px 0 14px;\n  display: flex; align-items: center; gap: 8px;\n}\n.url-row__input {\n  flex: 1; background: transparent; border: 0; outline: 0; height: 100%;\n  font-family: var(--font-bold); font-size: 13px; color: var(--text-input);\n  font-weight: bold; min-width: 0;\n}\n.url-row__input::placeholder { color: #888; font-weight: normal; }\n\n.btn-tiny {\n  background: var(--faktisk-blue); color: #fff;\n  font-family: var(--font-bold); font-weight: bold; font-size: 13px;\n  height: 30px; padding: 0 12px;\n  border-radius: var(--radius-input); white-space: nowrap;\n}\n.btn-tiny:hover { background: var(--faktisk-blue-hover); }\n\n.tool-section { display: flex; flex-direction: column; gap: 8px; }\n.caption-input {\n  background: var(--bg-input); border: 0; outline: 0;\n  border-radius: var(--radius-input);\n  padding: 10px 14px;\n  font-weight: bold; font-size: 13px; color: var(--text-input);\n  resize: vertical; line-height: 1.35; font-family: inherit;\n}\n.caption-input::placeholder { color: #888; font-weight: normal; }\n\n.slider-row {\n  display: flex; align-items: center; gap: 8px;\n}\n.slider-row .lbl {\n  font-family: var(--font-bold); font-weight: bold; font-size: 12px;\n  color: #fff; opacity: 0.85; min-width: 68px;\n}\n.slider-row input[type=range] { flex: 1; accent-color: var(--faktisk-blue); }\n\n.check-row {\n  display: flex; align-items: center; gap: 7px;\n  font-family: var(--font-regular); font-size: 13px; color: #fff; cursor: pointer;\n}\n.check-inline { white-space: nowrap; font-size: 12px; }\n\n.opt-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }\n.partner-opts { display: flex; flex-direction: column; gap: 6px; }\n.select-inline {\n  flex: 1; height: 30px; padding: 0 26px 0 10px; font-size: 12px;\n}\n.mini-del {\n  background: transparent; color: #FFB4B4; font-size: 12px;\n  cursor: pointer; text-decoration: underline;\n}\n\n.project-row { display: flex; flex-direction: column; gap: 6px; }\n.project-select {\n  width: 100%; height: 36px;\n  background: var(--bg-input); border: 0; border-radius: var(--radius-input);\n  padding: 0 32px 0 12px;\n  font-family: var(--font-bold); font-weight: bold; font-size: 13px;\n  color: var(--text-input); cursor: pointer;\n  appearance: none; -webkit-appearance: none;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' stroke='%23313131' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>\");\n  background-repeat: no-repeat;\n  background-position: right 12px center;\n}\n.project-row .btn-tiny { width: 100%; height: 36px; }\n\n.export-row { display: flex; flex-direction: column; gap: 8px; }\n.export-row__sub { display: flex; gap: 8px; }\n.export-row__sub .btn-tiny { flex: 1; background: rgba(255,255,255,0.14); }\n.export-row__sub .btn-tiny:hover { background: rgba(255,255,255,0.28); }\n\n/* Canvas */\n.plugin-canvas {\n  display: flex; flex-direction: column;\n  overflow: hidden; min-width: 0;\n}\n.canvas-area {\n  position: relative; flex: 1;\n  background: var(--bg-letterbox);\n  border-radius: 10px; overflow: hidden;\n  display: flex; align-items: center; justify-content: center;\n}\n#previewCanvas {\n  max-width: 100%; max-height: 100%;\n  border-radius: 6px;\n  background: #000;\n  cursor: grab;\n}\n#previewCanvas.dragging { cursor: grabbing; }\n"
}